@page
@model NEXT.Pages.HomepageModel
@{
    ViewData["Title"] = "Homepage";
}
<div class="homepage-wrapper">
    <img src="/images/corner.png" class="corner-logo" />
    <div class="homepage-container">

        @if (Model.RegisteredEvents != null && Model.RegisteredEvents.Any())
        {
            <section class="section-block">
                <h2 class="section-title">Hier heb je je aangemeld voor</h2>

                <div class="row g-4">
                    @foreach (var ev in Model.RegisteredEvents)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card event-card">
                                <img src="@ev.ImageUrl" class="event-image" alt="@ev.Title" />

                                <div class="event-card-body">
                                    <a asp-page="/EventDetails" asp-route-id="@ev.Id" style="text-decoration:none; color:inherit;">
                                        <h5 class="card-title">@ev.Title</h5>
                                    </a>

                                    <div class="event-meta">
                                        <p><strong>Locatie:</strong> @ev.Location</p>
                                        <p><strong>Datum:</strong> @ev.Date</p>
                                        <p><strong>Organizer:</strong> @ev.Organizer</p>
                                    </div>

                                    <div class="event-actions">
                                        <form method="post" asp-page-handler="Unregister" onsubmit="return confirm('Wil je zeker afmelden?');">
                                            <input type="hidden" name="id" value="@ev.Id" />
                                            <button type="submit" class="btn btn-nera-secondary">Afmelden</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        <section class="section-block">
            <h2 class="section-title">Komende evenementen</h2>

            @if (Model.UpcomingEvents == null || !Model.UpcomingEvents.Any())
            {
                <p class="empty-text">Er zijn momenteel geen komende evenementen beschikbaar.</p>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var ev in Model.UpcomingEvents)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card event-card">
                                <img src="@ev.ImageUrl" class="event-image" alt="@ev.Title" />

                                <div class="event-card-body">
                                    <a asp-page="/EventDetails" asp-route-id="@ev.Id" style="text-decoration:none; color:inherit;">
                                        <h5 class="card-title">@ev.Title</h5>
                                    </a>

                                    <div class="event-meta">
                                        <p><strong>Locatie:</strong> @ev.Location</p>
                                        <p><strong>Datum:</strong> @ev.Date</p>
                                        <p><strong>Organizer:</strong> @ev.Organizer</p>
                                    </div>

                                    <div class="event-actions">
                                        <form method="post" asp-page-handler="Register" onsubmit="return confirm('Wil je zeker aanmelden?');">
                                            <input type="hidden" name="id" value="@ev.Id" />
                                            <button type="submit" class="btn btn-nera-primary">Meld aan</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

    </div>
</div>