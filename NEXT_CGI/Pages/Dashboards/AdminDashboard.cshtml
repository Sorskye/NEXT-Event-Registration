@page
@model NEXT.Pages.Dashboards.AdminDashboardModel

@{
    ViewData["Title"] = "AdminDashboard";
}

<div class="dashboard-header">
    <div>
        <p class="dashboard-greeting">Welkom terug,</p>
        <h1 class="dashboard-name">@Model.UserName</h1>
    </div>
    @if (Model.UserMadeEvents != null && Model.UserMadeEvents.Any())
    {
        <a asp-page="/Events/CreateEvent" class="btn btn-nera-primary dashboard-new-btn">
            + Nieuw evenement
        </a>
    }
</div>

<div class="homepage-wrapper">
    <div class="homepage-container">

        <section class="section-block">
            <h2 class="section-title">Jouw aankomende evenementen:</h2>
        </section>

        @if (Model.UserMadeEvents != null && Model.UserMadeEvents.Any())
        {
            <section class="section-block">
                <div class="row g-4">
                    @foreach (var ev in Model.UserMadeEvents)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card event-card">
                                <img src="@ev.ImageUrl" class="event-image" alt="@ev.Title" />

                                <div class="event-card-body">

                                    <a asp-page="/Events/EventDetails"
                                       asp-route-id="@ev.Id"
                                       class="stretched-link"
                                       aria-label="Bekijk @ev.Title"></a>

                                    <h5 class="card-title">@ev.Title</h5>

                                    <div class="event-meta">
                                        <p><strong>Locatie:</strong> @ev.Location</p>
                                        <p><strong>Datum:</strong> @ev.Beginning_date?.ToString("dd-MM-yyyy") @ev.Beginning_time?.ToString("HH:mm")</p>
                                        <p><strong>Organizer:</strong> @ev.Organizer</p>
                                    </div>

                                    <div class="event-actions">
                                        <div class="event-rapport">
                                            <a asp-page="/Dashboards/Rapport"
                                               asp-route-id="@ev.Id"
                                               class="btn btn-nera-secondary">
                                                Bekijk rapport
                                            </a>
                                        </div>

                                        <div class="event-qr">
                                            <a asp-page="/Events/EventQr"
                                               asp-route-id="@ev.Id"
                                               class="btn btn-nera-secondary">
                                                Toon QR-code
                                            </a>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="none" viewBox="0 0 24 24" stroke="#9ca3af" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                    </svg>
                </div>
                <h3 class="empty-state-title">Geen aankomende evenementen</h3>
                <p class="empty-state-text">Je hebt nog geen evenementen aangemaakt. Maak je eerste evenement aan om te beginnen.</p>
                <a asp-page="/Events/CreateEvent" class="btn btn-nera-primary" style="width: auto; padding: 12px 28px;">
                    + Nieuw evenement aanmaken
                </a>
            </div>
        }

        <section class="section-block">
            <h2 class="section-title">Jouw verlopen evenementen:</h2>
        </section>

        @if (Model.EndedEvents != null && Model.EndedEvents.Any())
        {
            <section class="section-block">
                <div class="row g-4">
                    @foreach (var ev in Model.EndedEvents)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card event-card">
                                <img src="@ev.ImageUrl" class="event-image" alt="@ev.Title" />

                                <div class="event-card-body">

                                    <a asp-page="/Events/EventDetails"
                                       asp-route-id="@ev.Id"
                                       class="stretched-link"
                                       aria-label="Bekijk @ev.Title"></a>

                                    <div class="event-meta">
                                        <p><strong>Locatie:</strong> @ev.Location</p>
                                        <p>
                                            <strong>Datum:</strong>
                                            @ev.Beginning_date?.ToString("dd-MM-yyyy") @ev.Beginning_time?.ToString("HH:mm")
                                        </p>
                                        <p><strong>Organizer:</strong> @ev.Organizer</p>
                                    </div>

                                    <div class="event-actions">
                                        <div class="event-rapport">
                                            <a asp-page="/Dashboards/Rapport"
                                               asp-route-id="@ev.Id"
                                               class="btn btn-nera-secondary">
                                                Bekijk rapport
                                            </a>
                                        </div>

                                        <div class="event-qr">
                                            <a asp-page="/Events/EventQr"
                                               asp-route-id="@ev.Id"
                                               class="btn btn-nera-secondary">
                                                Toon QR-code
                                            </a>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
        else
        {
            <p>Geen afgelopen evenementen.</p>
        }

    </div>
</div>
