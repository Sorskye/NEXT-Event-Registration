@page
@model NEXT.Pages.Dashboards.AdminDashboardModel

@{
    ViewData["Title"] = "AdminDashboard";
}

<div class="dashboard-header">
    <div>
        <p class="dashboard-greeting">Welkom terug,</p>
        <h1 class="dashboard-name">@Model.UserName </h1>
    </div>
    <a asp-page="/Events/CreateEvent" class="btn btn-nera-primary dashboard-new-btn">
        + Nieuw evenement
    </a>
</div>


<div class="homepage-wrapper">
    <div class="homepage-container">

        <section class="section-block">
            <h2 class="section-title">Jouw komende evenementen:</h2>
        </section>

        @if (Model.UpcomingEvents != null && Model.UpcomingEvents.Any())
        {
            <section class="section-block">
                <div class="row g-4">
                    @foreach (var ev in Model.UpcomingEvents)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card event-card">
                                <img src="@ev.ImageUrl" class="event-image" alt="@ev.Title" />

                                <div class="event-card-body">

                                    <a asp-page="/Events/EventDetails"
                                       asp-route-id="@ev.Id"
                                       class="stretched-link"
                                       aria-label="Bekijk @ev.Title"></a>

                                    <div class="event-meta">
                                        <p><strong>Locatie:</strong> @ev.Location</p>
                                        <p><strong>Datum:</strong> @ev.Beginning_date?.ToString("dd-MM-yyyy") @ev.Beginning_time?.ToString("HH:mm")</p>
                                        <p><strong>Organizer:</strong> @ev.Organizer</p>
                                    </div>

                                    <div class="event-actions">

                                        <div class="event-rapport">
                                            <a asp-page="/Dashboards/Rapport"
                                               asp-route-id="@ev.Id"
                                               class="btn btn-nera-secondary">
                                                Bekijk rapport
                                            </a>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
        else
        {
            <p>Je hebt nog geen evenementen aangemaakt.</p>
        }

        <section class="section-block">
            <h2 class="section-title">Jouw verlopen evenementen:</h2>
        </section>

        @if (Model.EndedEvents != null && Model.EndedEvents.Any())
        {
            <section class="section-block">
                <div class="row g-4">

                    @foreach (var ev in Model.EndedEvents)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card event-card">
                                <img src="@ev.ImageUrl" class="event-image" alt="@ev.Title" />

                                <div class="event-card-body">

                                    <a asp-page="/Events/EventDetails"
                                       asp-route-id="@ev.Id"
                                       class="stretched-link"
                                       aria-label="Bekijk @ev.Title"></a>

                                    <div class="event-meta">
                                        <p><strong>Locatie:</strong> @ev.Location</p>
                                        <p>
                                            <strong>Datum:</strong>
                                            @ev.Beginning_date?.ToString("dd-MM-yyyy")
                                            @ev.Beginning_time?.ToString("HH:mm")
                                        </p>
                                        <p><strong>Organizer:</strong> @ev.Organizer</p>
                                    </div>

                                    <div class="event-actions">
                                        <div class="event-rapport">
                                            <a asp-page="/Dashboards/Rapport"
                                               asp-route-id="@ev.Id"
                                               class="btn btn-nera-secondary">
                                                Bekijk rapport
                                            </a>
                                        </div>
                                    </div>
                                    <div class="event-card">
                                        <img src="/api/qrcode/event/@ev.Id" alt="QR-code voor @ev.Name" width="200" height="200" />
                                    </div>

                                </div>
                            </div>
                        </div>
                    }

                </div>
            </section>
        }
        else
        {
            <p>Geen afgelopen evenementen.</p>
        }

    </div>
</div>
