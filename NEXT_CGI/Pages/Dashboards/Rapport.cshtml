@page "/AdminDashboard/Rapport"
@model NEXT.Pages.Dashboards.RapportModel
@{
	ViewData["Title"] = "Rapportage";
}

<link rel="stylesheet" href="~/css/presence.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<div class="container mt-4">

    <div class="row">
        <h2 class="mb-0">Aanwezigheid <small class="text-muted"></small></h2>
    </div>

    <!-- Summary Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row text-center">
                <div class="col">
                    <div class="d-flex align-items-center justify-content-center">
                        <i class="bi bi-people-fill fs-4 me-2 text-primary"></i>
                        <div class="text-start">
                            <div class="text-muted small">Totaal registraties</div>
                            <div class="fs-4 fw-bold">5</div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="d-flex align-items-center justify-content-center">
                        <i class="bi bi-check-circle-fill fs-4 me-2 text-success"></i>
                        <div class="text-start">
                            <div class="text-muted small">Aanwezig</div>
                            <div class="fs-4 fw-bold">0</div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="d-flex align-items-center justify-content-center">
                        <i class="bi bi-x-circle-fill fs-4 me-2 text-danger"></i>
                        <div class="text-start">
                            <div class="text-muted small">Afwezig</div>
                            <div class="fs-4 fw-bold">5</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Participant Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Deelnemerslijst</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px"></th>
                            <th>Naam</th>
                            <th>E-mailadres</th>
                            <th>Geregistreerd op</th>
                            <th style="width: 120px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < 5; i++)
                        {
                            <tr class="align-middle">
                                <td>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="" id="check@(i)">
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="me-3">
                                            <i class="bi bi-person-circle fs-4 text-muted"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold">Name</div>
                                            <div class="text-muted small">E-mailaddress</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-muted">
                                    E-mailaddress
                                </td>
                                <td class="text-muted">
                                    Registered at: dd-mm-yyyy
                                </td>
                                <td>
                                    <span class="badge bg-danger bg-opacity-10 text-danger">
                                        <i class="bi bi-x-circle-fill me-1"></i> Absent
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
     </div>
</div>
