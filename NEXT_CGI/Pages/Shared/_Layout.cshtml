
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NERA</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NERA.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentPath = Context.Request.Path.Value ?? string.Empty;
        var isAdmin = string.Equals(Context.Session.GetString("UserRole"), "Admin", StringComparison.OrdinalIgnoreCase);
        var dashboardPage = isAdmin ? "/Dashboards/AdminDashboard" : "/Dashboards/UserDashboard";
        var isHomeActive = currentPath.Contains("/Home", StringComparison.OrdinalIgnoreCase)
            || currentPath.Contains("/Homepage", StringComparison.OrdinalIgnoreCase);
        var isDashboardActive = currentPath.Contains("/Dashboards", StringComparison.OrdinalIgnoreCase);
        var isLoginPage = currentPath.Equals("/Login", StringComparison.OrdinalIgnoreCase)
            || currentPath.Contains("/Auth/Login", StringComparison.OrdinalIgnoreCase);
    }
    @if (!isLoginPage)
    {
        <header>
            <nav class="nera-navbar">
                <div class="container nera-navbar-inner">
                    <a class="nera-brand" asp-area="" asp-page="/Home/Homepage" aria-label="NERA home">
                        <img src="/images/corner.png" class="nera-brand-logo" alt="" />
                        <span class="nera-brand-name">NERA</span>
                        <span class="nera-brand-divider"></span>
                        <span class="nera-brand-subtitle">DOOR<br />CGI</span>
                    </a>

                    <div class="nera-nav-links">
                        <a class="nera-nav-link @(isHomeActive ? "active" : "")" asp-area="" asp-page="/Home/Homepage">Home</a>
                        <a class="nera-nav-link @(isDashboardActive ? "active" : "")" asp-area="" asp-page="@dashboardPage">Dashboard</a>

                        @if (!string.IsNullOrEmpty(Context.Session.GetString("UserName")))
                        {
                            <form method="post" asp-page="/Home/Homepage" asp-page-handler="Logout" class="navbar-logout-form">
                                <button type="submit" class="navbar-logout-btn">Uitloggen</button>
                            </form>
                        }
                    </div>
                </div>
            </nav>
        </header>
    }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
