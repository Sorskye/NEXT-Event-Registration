@page "/EventDetails"
@model NEXT.Pages.Events.EventDetailsModel
@{
    ViewData["Title"] = "Event Details";
}

<div class="details-page">
    <div class="details-container">
        <a asp-page="/Home/Homepage" class="back-link">← Terug naar evenementen</a>

        <div class="details-grid">
            <section class="details-main-card">
                <img src="@Model.SelectedEvent.ImageUrl"
                     alt="@Model.SelectedEvent.Name"
                     class="details-image" />

                <div class="details-main-body">
                    <div class="event-badge">NERA Event</div>

                    <h1 class="event-title">@Model.SelectedEvent.Name</h1>

                    <p class="event-description">
                        @Model.SelectedEvent.Description
                    </p>

                    <div class="event-highlight-box">
                        @{
                            var isExpiredHighlight = Model.SelectedEvent.Beginning_date.HasValue &&
                                                     Model.SelectedEvent.Beginning_date.Value.ToDateTime(
                                                         Model.SelectedEvent.Beginning_time ?? TimeOnly.MinValue) < DateTime.Now;
                        }
                        @if (isExpiredHighlight)
                        {
                            <h2 class="event-highlight-title">Dit evenement is verlopen</h2>
                            <p class="event-highlight-text">
                                Dit evenement is al begonnen of afgelopen. Aanmelden is helaas niet meer mogelijk.
                            </p>
                        }
                        else if (Model.IsRegistered)
                        {
                            <h2 class="event-highlight-title">Je bent aangemeld</h2>
                            <p class="event-highlight-text">
                                Je registratie is bevestigd. Fijn dat je erbij bent. Kun je toch niet komen, meld je dan op tijd af zodat anderen mogelijk kunnen deelnemen.
                            </p>
                        }
                        else
                        {
                            <h2 class="event-highlight-title">Wil je deelnemen?</h2>
                            <p class="event-highlight-text">
                                Meld je aan voor dit evenement om je plek te reserveren.
                            </p>
                        }
                    </div>
                </div>
            </section>

            <aside class="details-side-card">
                <h2 class="side-title">Evenement informatie</h2>

                <div class="info-list">
                    <div class="info-item">
                        <div class="info-label">Locatie</div>
                        <div class="info-value">@Model.SelectedEvent.LocationName</div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">Begindatum</div>
                        <div class="info-value">
                            @Model.SelectedEvent.Beginning_date?.ToString("dd-MM-yyyy")
                            @Model.SelectedEvent.Beginning_time?.ToString("HH:mm")
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">Einddatum</div>
                        <div class="info-value">
                            @Model.SelectedEvent.Ending_date?.ToString("dd-MM-yyyy")
                            @Model.SelectedEvent.Ending_time?.ToString("HH:mm")
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">Organizer</div>
                        <div class="info-value">@Model.SelectedEvent.Organizer</div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">Deelnemers</div>
                        <div class="info-value">@Model.SelectedEvent.CurrentParticipants / @Model.SelectedEvent.MaxParticipants</div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">Kosten</div>
                        <div class="info-value">@Model.SelectedEvent.Cost</div>
                    </div>
                </div>

                <div class="action-box">
                    @{
                        var isExpired = Model.SelectedEvent.Beginning_date.HasValue &&
                                        Model.SelectedEvent.Beginning_date.Value.ToDateTime(
                                            Model.SelectedEvent.Beginning_time ?? TimeOnly.MinValue) < DateTime.Now;
                    }
                    @if (isExpired)
                    {
                        <div class="action-title">Evenement verlopen</div>
                        <p class="action-text">
                            Dit evenement is al begonnen of afgelopen. Aanmelden is niet meer mogelijk.
                        </p>
                        <button class="btn btn-nera-secondary" disabled>Niet meer beschikbaar</button>
                    }
                    else if (Model.IsRegistered)
                    {
                        <div class="action-title">Registratie beheren</div>
                        <p class="action-text">
                            Je staat momenteel geregistreerd voor dit evenement.
                        </p>

                        <form method="post" asp-page="/Home/Homepage" asp-page-handler="Unregister">
                            <input type="hidden" name="id" value="@Model.SelectedEvent.Id" />
                            <button type="submit" class="btn btn-nera-secondary">Afmelden</button>
                        </form>
                    }
                    else
                    {
                        <div class="action-title">Direct aanmelden</div>
                        <p class="action-text">
                            Schrijf je in om deel te nemen aan dit evenement.
                        </p>

                        <form method="post" asp-page="/Home/Homepage" asp-page-handler="Register">
                            <input type="hidden" name="id" value="@Model.SelectedEvent.Id" />
                            <button type="submit" class="btn btn-nera-primary">Meld aan</button>
                        </form>
                    }
                </div>

                @if (Model.IsCreator)
                {
                    <div class="action-box" style="border-top: 1px solid #f3f4f6; margin-top: 12px; padding-top: 20px;">
                        <div class="action-title" style="color: #dc2626;">Evenement verwijderen</div>
                        <p class="action-text">Als organisator van dit event, kun je dit evenement permanent verwijderen.</p>
                        <form method="post" asp-page-handler="Delete" id="delete-event-form">
                            <input type="hidden" name="id" value="@Model.SelectedEvent.Id" />
                            <button type="button" class="btn btn-danger"
                                    onclick="document.getElementById('delete-modal').classList.add('active')">
                                Verwijderen
                            </button>
                        </form>
                    </div>
                }
            </aside>
        </div>
    </div>
</div>

<div id="delete-modal" class="confirm-modal-overlay">
    <div class="confirm-modal">
        <div class="confirm-modal-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
        </div>
        <h3 class="confirm-modal-title">Evenement verwijderen</h3>
        <p class="confirm-modal-text">Weet je zeker dat je <strong>@Model.SelectedEvent?.Name</strong> wilt verwijderen? Dit kan niet ongedaan worden gemaakt.</p>
        <div class="confirm-modal-actions">
            <button type="button" class="btn btn-nera-secondary" style="width: auto; padding: 12px 28px;"
                    onclick="document.getElementById('delete-modal').classList.remove('active')">
                Annuleren
            </button>
            <button type="submit" form="delete-event-form" class="btn btn-danger" style="width: auto; padding: 12px 28px;">
                Verwijderen
            </button>
        </div>
    </div>
</div>
