@page "{id:int}"
@model NEXT.Pages.Events.EventQrModel

@{
    ViewData["Title"] = "QR-code voor evenement";
}

@if (Model.EventItem != null)
{
    <div class="details-page">
        <div class="details-container">

            <a asp-page="/Dashboards/AdminDashboard" class="back-link">← Terug naar dashboard</a>

            <div class="details-grid">

                <section class="details-main-card">
                    <img src="@Model.EventItem.ImageUrl"
                         alt="@Model.EventItem.Title"
                         class="details-image" />

                    <div class="details-main-body">
                        <div class="event-badge">NERA Event</div>
                        <h1 class="event-title">@Model.EventItem.Title</h1>
                        <p class="event-description">@Model.EventItem.Description</p>

                        <div class="event-highlight-box">
                            <h2 class="event-highlight-title">QR-code voor inchecken</h2>
                            <p class="event-highlight-text">
                                Laat bezoekers deze QR-code scannen bij de ingang om hun aanwezigheid te bevestigen.
                            </p>

                            <div style="text-align:center; margin-top: 20px;">
                                <img src="/api/qrcode/event/@Model.EventItem.Id"
                                     alt="QR-code voor @Model.EventItem.Title"
                                     style="max-width: 260px; width: 100%; border-radius: 12px; padding: 12px; background: white; border: 1px solid #eef0f4;" />
                            </div>

                            <div style="display:flex; gap:10px; margin-top:20px; flex-wrap:wrap;">
                                <button type="button"
                                        class="btn btn-nera-secondary"
                                        style="flex:1;"
                                        onclick="window.print()">
                                    Print
                                </button>
                                <a href="/api/qrcode/event/@Model.EventItem.Id"
                                   download="qr-@(Model.EventItem.Id).png"
                                   class="btn btn-nera-primary" style="width:auto; flex:1;">
                                    Download QR-code
                                </a>
                            </div>
                        </div>
                    </div>
                </section>

                <aside class="details-side-card">
                    <h2 class="side-title">Evenement informatie</h2>

                    <div class="info-list">
                        <div class="info-item">
                            <div class="info-label">Locatie</div>
                            <div class="info-value">@Model.EventItem.LocationName</div>
                        </div>

                        <div class="info-item">
                            <div class="info-label">Begindatum</div>
                            <div class="info-value">
                                @Model.EventItem.Beginning_date?.ToString("dd-MM-yyyy")
                                @Model.EventItem.Beginning_time?.ToString("HH:mm")
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-label">Einddatum</div>
                            <div class="info-value">
                                @Model.EventItem.Ending_date?.ToString("dd-MM-yyyy")
                                @Model.EventItem.Ending_time?.ToString("HH:mm")
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-label">Organizer</div>
                            <div class="info-value">@Model.EventItem.Organizer</div>
                        </div>

                        <div class="info-item">
                            <div class="info-label">Deelnemers</div>
                            <div class="info-value">@Model.EventItem.CurrentParticipants / @Model.EventItem.MaxParticipants</div>
                        </div>
                    </div>

                    <div class="action-box" style="margin-top: 20px;">
                        <div class="action-title">Directe link</div>
                        <p class="action-text" style="word-break: break-all;">
                            <a href="@Model.QrTargetUrl" target="_blank" rel="noopener noreferrer">
                                @Model.QrTargetUrl
                            </a>
                        </p>
                    </div>
                </aside>

            </div>
        </div>
    </div>
}
else
{
    <div class="details-page">
        <div class="details-container">
            <p>Evenement niet gevonden.</p>
            <a asp-page="/Dashboards/AdminDashboard" class="btn btn-nera-secondary" style="width:auto;">
                Terug naar dashboard
            </a>
        </div>
    </div>
}
